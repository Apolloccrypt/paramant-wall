{
  "manifest_version": 3,
  "name": "Paramant Wall — Privacy Verifier",
  "version": "1.0.0",
  "description": "Verifies independently whether the site you're on routes its tracking through Paramant Wall — cookieless, IP-anonymised, PII-stripped.",
  "permissions": ["webRequest", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Paramant Wall — check this site",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
